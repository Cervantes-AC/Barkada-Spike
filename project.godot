; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Barkada Spike"
run/main_scene="res://scenes/menus/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

master/volume_db=0.0
master/buses=PackedStringArray("Music", "SFX")

[autoload]

GameManager="res://scripts/managers/game_manager.gd"
SaveManager="res://scripts/managers/save_manager.gd"
CharacterManager="res://scripts/managers/character_manager.gd"
TournamentManager="res://scripts/managers/tournament_manager.gd"
ProgressionManager="res://scripts/managers/progression_manager.gd"
AudioManager="res://scripts/managers/audio_manager.gd"
NetworkManager="res://scripts/network/network_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/width=1280
window/size/height=720

